  function applySkin(name) {
    var skin = KR_SKINS[name];
    if (!skin) return;
    var all = {};
    Object.keys(KR_SKINS).forEach(function (k) {
      Object.keys(KR_SKINS[k].tokens || {}).forEach(function (t) { all[t] = true; });
    });
    var root = document.documentElement;
    Object.keys(all).forEach(function (t) { root.style.removeProperty(t); });
    Object.keys(skin.tokens).forEach(function (t) {
      root.style.setProperty(t, skin.tokens[t]);
    });
    root.dataset.skin = name;
  }

  // ═══════════════════════════════════════════════════
  // ESTADO
  // ═══════════════════════════════════════════════════
  var state = {
    product: null,
    disponible: false,
    member: { isMember: false, hasPrime: false, membership: null },
    termsUrl: '',
    bootstrapped: false,
    currentView: 'loading'
  };

  var views = ['Loading', 'Empty', 'Buy', 'Redirecting', 'Success', 'Error'];

  // ═══════════════════════════════════════════════════
  // UTILIDADES
  // ═══════════════════════════════════════════════════
  function $(id) { return document.getElementById(id); }
  function esc(s) {
    if (s === null || s === undefined) return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  function fmtDate(d) {
    if (!d) return '—';
    try {
      var dt = new Date(d);
      if (isNaN(dt.getTime())) return '—';
      return dt.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
    } catch (e) { return '—'; }
  }
  function emailValido(e) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(e || '').trim());
  }
  function showView(name) {
    state.currentView = name;
    views.forEach(function (v) {
      var el = $('view' + v);
      if (el) el.classList.add('kp-hidden');
    });
    var target = $('view' + name.charAt(0).toUpperCase() + name.slice(1));
    if (target) target.classList.remove('kp-hidden');
  }

  // ═══════════════════════════════════════════════════
  // POST MESSAGE BRIDGE
  // ═══════════════════════════════════════════════════
  function send(type, payload) {
    try {
      window.parent.postMessage({ type: type, payload: payload || {} }, '*');
    } catch (e) {
      console.error('[TarjetaPrime] postMessage error:', e);
    }
  }

  var readyTimer = null;
  function startReadyRetry() {
    var fired = 0;
    function ping() {
      if (state.bootstrapped) {
        if (readyTimer) clearInterval(readyTimer);
        return;
      }
      fired++;
      send('ready');
      if (fired > 20) {
        if (readyTimer) clearInterval(readyTimer);
        showError('No se ha podido cargar el producto. Recarga la página.');
      }
    }
    ping();
    readyTimer = setInterval(ping, 700);
  }

  window.addEventListener('message', function (event) {
    var msg = event.data;
    if (!msg || typeof msg !== 'object' || !msg.type) return;
    handleMessage(msg);
  });

  function handleMessage(msg) {
    var p = msg.payload || {};
    switch (msg.type) {

      case 'bootstrap':
        if (p.skin) applySkin(p.skin);
        if (p.brandName) $('headerBrand').textContent = p.brandName;
        state.termsUrl = p.termsConditionsUrl || '';
        if (state.termsUrl) {
          $('termsLink').href = state.termsUrl;
          $('termsBlock').style.display = '';
        } else {
          // Si el salón no tiene URL configurada, ocultamos el bloque
          // para no enseñar un link roto. La compra sigue funcionando.
          $('termsBlock').style.display = 'none';
        }
        state.product = p.product || null;
        state.disponible = !!p.disponible;
        state.member = p.member || { isMember: false, hasPrime: false, membership: null };
        state.bootstrapped = true;
        if (!state.disponible || !state.product) {
          showView('empty');
        } else {
          renderBuy();
          showView('buy');
        }
        break;

      case 'loginRequired':
        $('loginNotice').classList.remove('kp-hidden');
        showView('buy');
        break;

      case 'alreadyPrime':
        // Mostrar bloque de "ya eres PRIME" + ocultar formulario.
        var m = p.membership || {};
        state.member.hasPrime = true;
        state.member.membership = m;
        renderBuy();
        showView('buy');
        break;

      case 'purchaseSuccess':
        mostrarSuccess(p);
        break;

      case 'purchaseCancelled':
        showView('buy');
        break;

      case 'purchaseError':
        showError(msg.message || 'No se pudo completar la compra');
        break;

      case 'error':
        showError(msg.message || 'Error');
        break;
    }
  }

  // ═══════════════════════════════════════════════════
  // RENDER VISTA DE COMPRA
  // ═══════════════════════════════════════════════════
  function renderBuy() {
    var p = state.product;
    if (!p) return;

    // Imagen tarjeta.
    var img = $('cardImage');
    var ph = $('cardPlaceholder');
    if (p.imagePublicUrl) {
      img.src = p.imagePublicUrl;
      img.style.display = 'block';
      ph.style.display = 'none';
    } else {
      img.style.display = 'none';
      ph.style.display = 'flex';
    }

    // Precio.
    $('heroPrice').textContent = Number(p.annualPrice || 0).toFixed(2).replace('.', ',');
    var months = p.durationMonths || 12;
    $('heroDuration').textContent = months === 12 ? 'por año' : 'cada ' + months + ' meses';

    // Beneficios.
    if (p.benefits) {
      $('benefitsBlock').classList.remove('kp-hidden');
      $('benefitsText').textContent = p.benefits;
    } else {
      $('benefitsBlock').classList.add('kp-hidden');
    }

    // Si ya es PRIME activo, mostrar bloque y ocultar formulario.
    if (state.member.hasPrime && state.member.membership) {
      var m = state.member.membership;
      $('primeActiveBlock').classList.remove('kp-hidden');
      $('primeActiveExpiration').textContent = fmtDate(m.expirationDate);
      $('primeActiveCode').textContent = m.code || '—';
      $('formBlock').classList.add('kp-hidden');
    } else {
      $('primeActiveBlock').classList.add('kp-hidden');
      $('formBlock').classList.remove('kp-hidden');
      $('btnBuy').textContent = 'Hazte PRIME · ' + Number(p.annualPrice || 0).toFixed(2).replace('.', ',') + ' €';
      validarForm();
    }
  }

  function validarForm() {
    var buyerName = $('inputBuyerName').value.trim();
    var buyerEmail = $('inputBuyerEmail').value.trim();
    var ok = !!buyerName && emailValido(buyerEmail);
    // Si el bloque de T&C está visible, el checkbox debe estar marcado.
    var termsVisible = $('termsBlock').style.display !== 'none';
    if (termsVisible && !$('inputTerms').checked) ok = false;
    $('btnBuy').disabled = !ok;
  }

  function comprar() {
    var payload = {
      buyerName: $('inputBuyerName').value.trim(),
      buyerEmail: $('inputBuyerEmail').value.trim(),
      buyerPhone: $('inputBuyerPhone').value.trim()
    };
    showView('redirecting');
    send('purchase', payload);
  }

  function mostrarSuccess(p) {
    var code = p && p.code ? String(p.code) : '—';
    var expFmt = p && p.expirationDate ? fmtDate(p.expirationDate) : '';
    $('successCode').textContent = code;
    $('successText').innerHTML = 'Tu membresía está activa'
      + (expFmt ? ' hasta el <strong>' + esc(expFmt) + '</strong>' : '')
      + '. Disfruta de tus ventajas en cada visita.';
    showView('success');
  }

  function showError(msg) {
    $('errorText').textContent = msg || 'Inténtalo de nuevo en un momento';
    showView('error');
  }

  // ═══════════════════════════════════════════════════
  // EVENT LISTENERS
  // ═══════════════════════════════════════════════════
  ['inputBuyerName', 'inputBuyerEmail', 'inputBuyerPhone'].forEach(function (id) {
    $(id).addEventListener('input', validarForm);
  });
  $('inputTerms').addEventListener('change', validarForm);
  $('btnBuy').addEventListener('click', comprar);
  $('btnSuccessClose').addEventListener('click', function () {
    // Tras éxito, recargamos el bootstrap (ahora el miembro ya es PRIME)
    state.bootstrapped = false;
    showView('loading');
    send('ready');
    startReadyRetry();
  });
  $('btnErrorReset').addEventListener('click', function () {
    showView('buy');
  });

  // ═══════════════════════════════════════════════════
  // ARRANQUE
  // ═══════════════════════════════════════════════════
  startReadyRetry();

})();
</script>
